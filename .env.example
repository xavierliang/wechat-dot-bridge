# Template only. Do not set true or run against real services before deployment,
# persistent access, account linking and the destination are explicitly approved.
BRIDGE_ENABLE_LIVE=false
BRIDGE_PUBLIC_URL=https://bridge.example.invalid/mcp
BRIDGE_AUTH_ISSUER=https://identity.example.invalid/
BRIDGE_OWNER_SUBJECT=replace-with-exact-verified-idp-subject
# Exact callback hostnames supplied by your actual host subscription; no wildcards.
# Leave empty for bootstrap: login/discovery/status work; no message runtime.
BRIDGE_CALLBACK_HOSTS=
# Owner web UI is a confidential Authorization Code + PKCE client; opt in only
# after the exact client, owner identity and secure secret provisioning are approved.
BRIDGE_ADMIN_UI_ENABLED=false
BRIDGE_ADMIN_CLIENT_ID=replace-with-approved-admin-client-id
BRIDGE_ADMIN_CLIENT_SECRET_FILE=/run/secrets/admin-client-secret
BRIDGE_JWKS_FILE=/run/secrets/idp-public-jwks.json
BRIDGE_STORAGE_KEY_FILE=/run/secrets/storage-key.raw
BRIDGE_TLS_KEY_FILE=/run/secrets/tls.key
BRIDGE_TLS_CERT_FILE=/run/secrets/tls.crt
BRIDGE_DATA_DIR=/data
BRIDGE_CHANNEL_VERSION=0.1.0
BRIDGE_BIND_HOST=0.0.0.0
BRIDGE_PORT=8443
# Safe local-only published port by default. Public 443 requires approved changes.
BRIDGE_PUBLISH_BIND=127.0.0.1
BRIDGE_PUBLISH_PORT=8443
